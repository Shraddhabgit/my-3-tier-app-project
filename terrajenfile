pipeline {
    agent any
    stages {
        stage('checkout from git') {
            steps {
                git branch: 'main', url: 'https://github.com/Shraddhabgit/my-3-tier-app-project.git'
            }
        }

        stage('terraform version') {
            steps {
                sh 'terraform --version'
            }
        }

        stage('Terraform Init') {
            steps {
                dir('terraform') {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform validate') {
            steps {
                dir('terraform') {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform plan') {
            steps {
                dir('terraform') {
                    sh 'terraform plan'
                }
            }
        }

        stage('Terraform apply/destroy') {
            steps {
                dir('terraform') {
                    sh 'terraform ${action} --auto-approve'
                }
            }
        }
    }
}
